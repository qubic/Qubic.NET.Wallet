@using Qubic.Services.Networks
@inject QubicBackendService Backend
@inject NetworkProfileService Profiles
@inject Microsoft.Extensions.Localization.IStringLocalizer<AppStrings> Loc
@implements IDisposable

@* Renders ChildContent only when the active network can serve every required capability;
   otherwise explains what is missing instead of failing (or silently using another network). *@
@if (Missing.Count == 0)
{
    @ChildContent
}
else
{
    <div class="alert alert-secondary d-flex align-items-start gap-2">
        <i class="bi bi-plug fs-4"></i>
        <div>
            <strong>@(Title ?? Loc["CG_NotAvailable"])</strong>
            <div class="small mt-1">
                "@Backend.Profile.Name" @Loc["CG_NoMethodPre"]
                @string.Join(", ", Missing.Select(c => LibStrings.Cap(Loc, c))).
                @Loc["CG_AddPre"] @string.Join(" / ", Missing.SelectMany(Capabilities.SupportedBy).Distinct().Select(Capabilities.MethodName)) @Loc["CG_AddPost"] <a href="/settings?tab=networks">@Loc["CG_SettingsNetworks"]</a>.
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Capability[] Requires { get; set; } = [];
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private List<Capability> Missing => Requires.Where(c => !Backend.IsAvailable(c)).ToList();

    protected override void OnInitialized() => Profiles.OnActiveProfileChanged += OnChanged;

    private void OnChanged(NetworkProfile _, NetworkProfile __) => InvokeAsync(StateHasChanged);

    public void Dispose() => Profiles.OnActiveProfileChanged -= OnChanged;
}
