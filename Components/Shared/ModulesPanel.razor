@using Qubic.Net.Wallet.Services
@inject ModuleVisibilityService Modules
@inject Microsoft.Extensions.Localization.IStringLocalizer<AppStrings> Loc

@* Show/hide optional wallet pages, grouped by navigation section. In Review mode choices are
   collected and saved together (first run); otherwise each switch applies immediately. *@
<div class="d-flex align-items-center justify-content-between mb-2">
    <span class="small text-muted">@_onCount / @ModuleVisibilityService.All.Count</span>
    <div class="btn-group btn-group-sm">
        <button type="button" class="btn btn-outline-secondary" @onclick="() => SetAll(true)">
            <i class="bi bi-check2-all me-1"></i>@Loc["Mod_EnableAll"]
        </button>
        <button type="button" class="btn btn-outline-secondary" @onclick="() => SetAll(false)">
            <i class="bi bi-dash-circle me-1"></i>@Loc["Mod_DisableAll"]
        </button>
    </div>
</div>

@foreach (var sec in ModuleVisibilityService.All.Select(m => m.SectionKey).Distinct())
{
    var items = ModuleVisibilityService.All.Where(m => m.SectionKey == sec).ToList();
    <div class="mb-3">
        <div class="d-flex align-items-center justify-content-between mb-1">
            <span class="nav-section-label text-uppercase small fw-semibold">@Loc[sec]</span>
            <div class="form-check form-switch m-0">
                <input class="form-check-input" type="checkbox" id="modsec-@sec"
                       checked="@items.All(i => IsChecked(i.Module))"
                       @onchange="e => SetSection(sec, (bool)(e.Value ?? false))" />
            </div>
        </div>
        <div class="list-group">
            @foreach (var m in items)
            {
                var on = IsChecked(m.Module);
                <div class="list-group-item">
                    <div class="d-flex align-items-start gap-3">
                        <div class="form-check form-switch mt-1">
                            <input class="form-check-input" type="checkbox" id="mod-@m.Module"
                                   checked="@on" @onchange="e => Toggle(m.Module, (bool)(e.Value ?? false))" />
                        </div>
                        <div class="flex-grow-1">
                            <label class="fw-semibold" for="mod-@m.Module">
                                <i class="bi @m.Icon me-1"></i>@Title(m)
                            </label>
                            <div class="small text-muted">@Loc[m.DescKey]</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    /// <summary>Collect choices and let the parent save them with <see cref="Save"/>.</summary>
    [Parameter] public bool Review { get; set; }

    /// <summary>Raised after a choice changed.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private readonly Dictionary<WalletModule, bool> _choices = [];

    protected override void OnInitialized()
    {
        foreach (var m in ModuleVisibilityService.All)
            _choices[m.Module] = Modules.IsEnabled(m.Module);
    }

    private int _onCount => ModuleVisibilityService.All.Count(m => IsChecked(m.Module));

    private string Title(ModuleInfo m) => m.TitleKey != null ? Loc[m.TitleKey] : (m.TitleLiteral ?? m.Module.ToString());

    private bool IsChecked(WalletModule m) => Review ? _choices.GetValueOrDefault(m) : Modules.IsEnabled(m);

    private void Set(WalletModule m, bool enabled)
    {
        if (Review) _choices[m] = enabled;
        else Modules.SetEnabled(m, enabled);
    }

    private async Task Toggle(WalletModule m, bool enabled)
    {
        Set(m, enabled);
        await OnChanged.InvokeAsync();
    }

    private async Task SetAll(bool enabled)
    {
        foreach (var m in ModuleVisibilityService.All) Set(m.Module, enabled);
        await OnChanged.InvokeAsync();
    }

    private async Task SetSection(string sectionKey, bool enabled)
    {
        foreach (var m in ModuleVisibilityService.All.Where(i => i.SectionKey == sectionKey))
            Set(m.Module, enabled);
        await OnChanged.InvokeAsync();
    }

    /// <summary>Review mode: applies all collected choices.</summary>
    public void Save()
    {
        foreach (var kv in _choices) Modules.SetEnabled(kv.Key, kv.Value);
    }
}
