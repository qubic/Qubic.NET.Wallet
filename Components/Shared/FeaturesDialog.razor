@using Qubic.Services.Features
@inject FeatureService Features
@inject Microsoft.Extensions.Localization.IStringLocalizer<AppStrings> Loc

@* Shown on first launch and after an update that adds opt-in features. Nothing optional runs until saved. *@
@if (_visible)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.6)">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title"><i class="bi bi-toggles me-2"></i>@Loc["FD_Title"]</h6>
                </div>
                <div class="modal-body">
                    <p class="small">
                        @Loc["FD_Intro"]
                        @Loc["FD_ChangeAnytime"] <em>@Loc["Common_SettingsFeatures"]</em>.
                    </p>
                    <FeaturesPanel @ref="_panel" Review="true" Desktop="Desktop" />

                    <h6 class="mt-4"><i class="bi bi-window-stack me-1"></i>@Loc["Mod_PagesTitle"]</h6>
                    <p class="small text-muted">@Loc["Mod_PagesIntro"]</p>
                    <ModulesPanel @ref="_modules" Review="true" />
                </div>
                <div class="modal-footer">
                    <button class="btn btn-sm btn-primary" @onclick="Save">
                        <i class="bi bi-check2 me-1"></i>@Loc["FD_SaveChoices"]
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Desktop { get; set; } = true;
    [Parameter] public EventCallback OnSaved { get; set; }

    private FeaturesPanel? _panel;
    private ModulesPanel? _modules;
    private bool _visible;

    protected override void OnInitialized() => _visible = Features.NeedsReview;

    private async Task Save()
    {
        _panel?.Save();
        _modules?.Save();
        _visible = false;
        await OnSaved.InvokeAsync();
    }
}
