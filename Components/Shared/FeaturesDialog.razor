@using Qubic.Services.Features
@inject FeatureService Features

@* Shown on first launch and after an update that adds opt-in features. Nothing optional runs until saved. *@
@if (_visible)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.6)">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title"><i class="bi bi-toggles me-2"></i>Choose optional features</h6>
                </div>
                <div class="modal-body">
                    <p class="small">
                        These features are <strong>off</strong> unless you turn them on. Features that are off do not
                        run at all — no connections, no listeners, no background downloads.
                        You can change this any time in <em>Settings → Features</em>.
                    </p>
                    <FeaturesPanel @ref="_panel" Review="true" Desktop="Desktop" />
                </div>
                <div class="modal-footer">
                    <button class="btn btn-sm btn-primary" @onclick="Save">
                        <i class="bi bi-check2 me-1"></i>Save choices
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Desktop { get; set; } = true;
    [Parameter] public EventCallback OnSaved { get; set; }

    private FeaturesPanel? _panel;
    private bool _visible;

    protected override void OnInitialized() => _visible = Features.NeedsReview;

    private async Task Save()
    {
        _panel?.Save();
        _visible = false;
        await OnSaved.InvokeAsync();
    }
}
