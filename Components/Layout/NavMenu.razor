@inject SeedSessionService Seed
@inject VaultService Vault
@inject NavigationManager Nav
@inject Qubic.Services.Features.FeatureService Features
@implements IDisposable
@inject Microsoft.Extensions.Localization.IStringLocalizer<AppStrings> Loc

<div class="qb-sidebar p-2 d-flex flex-column">
    <nav class="nav flex-column flex-grow-1">
        <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
            <i class="bi bi-house me-2"></i>@Loc["Nav_Home"]
        </NavLink>
        @if (Vault.IsUnlocked)
        {
            <NavLink class="nav-link" href="/accounts">
                <i class="bi bi-wallet2 me-2"></i>@Loc["Nav_VaultOverview"]
            </NavLink>
        }

        @* ── SEND & RECEIVE ── *@
        <div class="nav-section-header mt-2">
            <span class="nav-section-label">@Loc["Nav_Section_Transactions"]</span>
        </div>
        @if (Seed.HasSeed)
        {
            <NavLink class="nav-link" href="/send">
                <i class="bi bi-send me-2"></i>@Loc["Nav_Send"]
            </NavLink>
            <NavLink class="nav-link" href="/send-many">
                <i class="bi bi-send-plus me-2"></i>@Loc["Nav_SendToMany"]
            </NavLink>
            <NavLink class="nav-link" href="/receive">
                <i class="bi bi-qr-code me-2"></i>@Loc["Nav_Receive"]
            </NavLink>
        }
        else
        {
            <span class="nav-link text-muted small" title="Unlock seed to enable">
                <i class="bi bi-lock me-2"></i>@Loc["Nav_UnlockToSend"]
            </span>
        }

        @* ── ASSETS ── *@
        <div class="nav-section-header mt-2">
            <span class="nav-section-label">@Loc["Nav_Section_Assets"]</span>
        </div>
        <NavLink class="nav-link" href="/assets">
            <i class="bi bi-grid-3x3-gap me-2"></i>@Loc["Nav_Assets"]
        </NavLink>

        @* ── DEFI ── *@
        <div class="nav-section-header mt-2">
            <span class="nav-section-label">@Loc["Nav_Section_Defi"]</span>
        </div>
        <NavLink class="nav-link" href="/qx">
            <i class="bi bi-shop me-2"></i>@Loc["Nav_QxTrading"]
        </NavLink>
        <NavLink class="nav-link" href="/qswap">
            <i class="bi bi-arrow-left-right me-2"></i>QSwap
        </NavLink>
        <NavLink class="nav-link" href="/qearn">
            <i class="bi bi-piggy-bank me-2"></i>QEarn
        </NavLink>
        <NavLink class="nav-link" href="/msvault">
            <i class="bi bi-safe me-2"></i>MSVault
        </NavLink>
        <NavLink class="nav-link" href="/sc-auctions">
            <i class="bi bi-graph-up-arrow me-2"></i>@Loc["Nav_ScAuctions"]
        </NavLink>
        <NavLink class="nav-link" href="/voting">
            <i class="bi bi-chat-square-dots me-2"></i>@Loc["Nav_Voting"]
        </NavLink>

        @* ── HISTORY ── *@
        <div class="nav-section-header mt-2">
            <span class="nav-section-label">@Loc["Nav_Section_History"]</span>
        </div>
        <NavLink class="nav-link" href="/watchlist">
            <i class="bi bi-eye me-2"></i>@Loc["Nav_Watchlist"]
        </NavLink>
        <NavLink class="nav-link" href="/history">
            <i class="bi bi-list-ul me-2"></i>@Loc["Nav_TxHistory"]
        </NavLink>
        <NavLink class="nav-link" href="/logs">
            <i class="bi bi-journal-text me-2"></i>@Loc["Nav_LogEvents"]
        </NavLink>
        @* ── TOOLS ── *@
        <div class="nav-section-header mt-2">
            <span class="nav-section-label">@Loc["Nav_Section_Tools"]</span>
        </div>
        <NavLink class="nav-link" href="/sign-verify">
            <i class="bi bi-pen me-2"></i>@Loc["Nav_SignVerify"]
        </NavLink>
        @if (Features.IsEnabled(Qubic.Services.Features.WalletFeature.WalletConnect))
        {
            <NavLink class="nav-link" href="/walletconnect">
                <i class="bi bi-link-45deg me-2"></i>WalletConnect
            </NavLink>
        }
        @if (Features.IsEnabled(Qubic.Services.Features.WalletFeature.LocalSigningEndpoint))
        {
            <NavLink class="nav-link" href="/local-endpoint">
                <i class="bi bi-plug me-2"></i>@Loc["Nav_LocalEndpoint"]
            </NavLink>
        }

        @if (Features.IsEnabled(Qubic.Services.Features.WalletFeature.DeveloperTools))
        {
            <div class="nav-section-header mt-2">
                <span class="nav-section-label">@Loc["Nav_Section_Developer"]</span>
            </div>
            <NavLink class="nav-link" href="/devtools">
                <i class="bi bi-tools me-2"></i>@Loc["Nav_DevTools"]
            </NavLink>
            <NavLink class="nav-link" href="/contracts">
                <i class="bi bi-braces me-2"></i>@Loc["Nav_ContractConsole"]
            </NavLink>
        }

        <hr class="my-2" />
        <NavLink class="nav-link" href="/sync">
            <i class="bi bi-arrow-repeat me-2"></i>@Loc["Nav_SyncManager"]
        </NavLink>
        <NavLink class="nav-link" href="/settings">
            <i class="bi bi-gear me-2"></i>@Loc["Nav_Settings"]
        </NavLink>
    </nav>

    <div class="qb-sidebar-version text-center text-muted small mt-2 pt-2">
        v@_version
    </div>
</div>

@code {
    private static readonly string _version =
        typeof(NavMenu).Assembly.GetName().Version?.ToString(3) ?? "?";

    protected override void OnInitialized()
    {
        Seed.OnSeedChanged += OnSeedChanged;
        Features.OnChanged += OnFeatureChanged;
        Vault.OnVaultChanged += OnVaultChanged;
    }

    private void OnVaultChanged() => InvokeAsync(StateHasChanged);

    private void OnFeatureChanged(Qubic.Services.Features.WalletFeature _) => InvokeAsync(StateHasChanged);

    private void OnSeedChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Seed.OnSeedChanged -= OnSeedChanged;
        Features.OnChanged -= OnFeatureChanged;
        Vault.OnVaultChanged -= OnVaultChanged;
    }
}
