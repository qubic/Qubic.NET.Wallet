@page "/accounts"
@using Qubic.Core.Entities
@using Qubic.Services.Networks
@implements IDisposable
@inject VaultService Vault
@inject SeedSessionService Seed
@inject QubicBackendService Backend
@inject NetworkProfileService Profiles
@inject Qubic.Net.Wallet.Services.VaultActivationService VaultActivation

<h4>Vault Overview</h4>
<p class="text-muted">Every identity in your vault, with balances from <strong>@Backend.Profile.Name</strong>. No seed needs to be active.</p>

@if (!Vault.VaultConfigured)
{
    <div class="alert alert-secondary">No vault is set up. Create or open one in <a href="/settings?tab=vault">Settings → Vault</a>.</div>
}
else if (!Vault.IsUnlocked)
{
    <div class="alert alert-secondary">Unlock your vault in the top bar to see its identities.</div>
}
else if (Vault.Entries.Count == 0)
{
    <div class="alert alert-secondary">This vault has no identities yet. Add one in <a href="/settings?tab=vault">Settings → Vault</a>.</div>
}
else
{
    var entries = Vault.Entries;
    var loaded = entries.Count(e => Row(e.Identity).Balance != null);
    <div class="card mb-3">
        <div class="card-body d-flex flex-wrap align-items-center gap-4">
            <div>
                <div class="small text-muted">Identities</div>
                <div class="fs-4">@entries.Count</div>
            </div>
            <div>
                <div class="small text-muted">Total balance</div>
                @if (!_balanceAvailable)
                {
                    <div class="text-muted">not available on this network</div>
                }
                else
                {
                    <div class="fs-4">
                        @entries.Sum(e => Row(e.Identity).Balance ?? 0).ToString("N0") <small class="text-muted">QU</small>
                        @if (loaded < entries.Count)
                        {
                            <small class="text-muted fs-6 ms-1">(@loaded of @entries.Count loaded)</small>
                        }
                    </div>
                }
            </div>
            <div class="ms-auto text-end">
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => RefreshAsync()" disabled="@_refreshing">
                    @if (_refreshing) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    else { <i class="bi bi-arrow-clockwise me-1"></i> }
                    Refresh
                </button>
                @if (_lastRefresh is { } t)
                {
                    <div class="small text-muted mt-1">Updated @t.ToLocalTime().ToString("T")</div>
                }
            </div>
        </div>
    </div>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Label</th>
                        <th>Identity</th>
                        <th class="text-end">Balance (QU)</th>
                        @if (_assetsAvailable) { <th>Assets</th> }
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in entries)
                    {
                        var row = Row(entry.Identity);
                        var active = Seed.Identity?.ToString() == entry.Identity;
                        <tr class="@(active ? "table-active" : "")">
                            <td>
                                @entry.Label
                                @if (active) { <span class="badge bg-success ms-1">active</span> }
                            </td>
                            <td><AddressDisplay Address="@entry.Identity" ShowFull="true" /></td>
                            <td class="text-end mono">
                                @if (row.Balance is { } b) { @b.ToString("N0") }
                                else if (row.Error != null) { <span class="text-danger small" title="@row.Error">unavailable</span> }
                                else if (_balanceAvailable) { <span class="spinner-border spinner-border-sm text-muted"></span> }
                                else { <span class="text-muted">—</span> }
                            </td>
                            @if (_assetsAvailable)
                            {
                                <td>
                                    @if (row.Assets is { Count: > 0 } assets)
                                    {
                                        @foreach (var a in assets.Take(MaxAssetBadges))
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary-emphasis me-1 mono">@a.Name @a.Shares.ToString("N0")</span>
                                        }
                                        @if (assets.Count > MaxAssetBadges)
                                        {
                                            <span class="small text-muted" title="@string.Join(", ", assets.Skip(MaxAssetBadges).Select(x => x.Name))">+@(assets.Count - MaxAssetBadges) more</span>
                                        }
                                    }
                                    else if (row.Assets != null) { <span class="text-muted small">none</span> }
                                </td>
                            }
                            <td class="text-end">
                                @if (!active)
                                {
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => Activate(entry)">
                                        <i class="bi bi-unlock me-1"></i>Activate
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (_activateError != null) { <div class="text-danger small mt-2">@_activateError</div> }
}

@code {
    private const int MaxAssetBadges = 4;
    private const int MaxParallelRequests = 4;
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(30);

    private sealed record AssetHolding(string Name, long Shares);

    private sealed class RowState
    {
        public long? Balance;
        public string? Error;
        public List<AssetHolding>? Assets;
    }

    private readonly Dictionary<string, RowState> _rows = [];
    private readonly CancellationTokenSource _cts = new();
    private PeriodicTimer? _timer;
    private bool _refreshing;
    private bool _refreshAgain;
    private bool _balanceAvailable;
    private bool _assetsAvailable;
    private DateTime? _lastRefresh;
    private string? _activateError;

    private RowState Row(string identity)
    {
        lock (_rows)
        {
            if (!_rows.TryGetValue(identity, out var r)) _rows[identity] = r = new RowState();
            return r;
        }
    }

    protected override void OnInitialized()
    {
        Vault.OnVaultChanged += OnVaultChanged;
        Seed.OnSeedChanged += OnSeedChanged;
        Profiles.OnActiveProfileChanged += OnProfileChanged;
        _ = RefreshAsync();
        _ = RefreshLoopAsync();
    }

    private async Task RefreshLoopAsync()
    {
        _timer = new PeriodicTimer(RefreshInterval);
        try
        {
            while (await _timer.WaitForNextTickAsync(_cts.Token))
                await RefreshAsync();
        }
        catch (OperationCanceledException) { }
    }

    private async Task RefreshAsync(bool clear = false)
    {
        if (clear) lock (_rows) _rows.Clear();
        if (!Vault.IsUnlocked) return;
        // A request during a running refresh (network switch, vault edit) runs right after it.
        if (_refreshing) { _refreshAgain = true; return; }
        _refreshing = true;
        _balanceAvailable = Backend.IsAvailable(Capability.Balance);
        _assetsAvailable = Backend.IsAvailable(Capability.AssetListings);
        await InvokeAsync(StateHasChanged);

        var identities = Vault.Entries.Select(e => e.Identity).ToList();
        using var gate = new SemaphoreSlim(MaxParallelRequests);
        try
        {
            await Task.WhenAll(identities.Select(async identity =>
            {
                await gate.WaitAsync(_cts.Token);
                try { await LoadAsync(identity, _cts.Token); }
                finally { gate.Release(); }
                await InvokeAsync(StateHasChanged);
            }));
            _lastRefresh = DateTime.UtcNow;
        }
        catch (OperationCanceledException) { return; }
        finally { _refreshing = false; }
        await InvokeAsync(StateHasChanged);
        if (_refreshAgain)
        {
            _refreshAgain = false;
            await RefreshAsync();
        }
    }

    private async Task LoadAsync(string identity, CancellationToken ct)
    {
        var row = Row(identity);
        var id = QubicIdentity.FromIdentity(identity);
        if (_balanceAvailable)
        {
            try
            {
                row.Balance = (await Backend.GetBalanceAsync(id, ct)).Amount;
                row.Error = null;
            }
            catch (Exception ex) when (ex is not OperationCanceledException) { row.Error = ex.Message; }
        }
        if (_assetsAvailable)
        {
            try
            {
                var owned = await Backend.GetOwnedAssetsAsync(id, ct);
                row.Assets = owned
                    .Select(a => new AssetHolding(a.Data.IssuedAsset?.Name ?? "?", long.TryParse(a.Data.NumberOfUnits, out var n) ? n : 0))
                    .Where(a => a.Shares > 0)
                    .OrderByDescending(a => a.Shares)
                    .ToList();
            }
            catch (Exception ex) when (ex is not OperationCanceledException) { row.Assets ??= []; }
        }
    }

    private void Activate(VaultEntry entry)
    {
        _activateError = null;
        try { VaultActivation.Activate(entry); }
        catch (Exception ex) { _activateError = ex.Message; }
    }

    private void OnVaultChanged()
    {
        InvokeAsync(StateHasChanged); // locked / unlocked / entries changed
        _ = RefreshAsync();
    }

    private void OnSeedChanged() => InvokeAsync(StateHasChanged);

    // Balances belong to the network they were read from.
    private void OnProfileChanged(NetworkProfile oldProfile, NetworkProfile newProfile) => _ = RefreshAsync(clear: true);

    public void Dispose()
    {
        Vault.OnVaultChanged -= OnVaultChanged;
        Seed.OnSeedChanged -= OnSeedChanged;
        Profiles.OnActiveProfileChanged -= OnProfileChanged;
        _cts.Cancel();
        _timer?.Dispose();
    }
}
