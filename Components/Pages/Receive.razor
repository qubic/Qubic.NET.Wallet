@page "/receive"
@inject SeedSessionService Seed
@inject QubicBackendService Backend
@inject IJSRuntime JS

<h4>Receive QU</h4>

@if (!Seed.HasSeed)
{
    <div class="alert alert-warning">Enter your seed in the top bar to view your address.</div>
}
else
{
    <div class="row g-3">
        <div class="col-md-7">
            <div class="card">
                <div class="card-header">Your Identity</div>
                <div class="card-body text-center py-4">
                    <p class="text-muted small mb-3">
                        @(_isRequest ? "Scan to pay. The QR code contains a payment request (qubic: link)." : "Share this address to receive QU or assets.")
                    </p>
                    @if (_qrSvg != null)
                    {
                        <div class="mb-3 d-flex justify-content-center">
                            <div id="qr-container" class="qb-qr-box">
                                @((MarkupString)_qrSvg)
                            </div>
                        </div>
                    }
                    <div class="p-3 bg-body-tertiary rounded mb-3">
                        <code class="mono d-block @(_isRequest ? "small" : "fs-5")" style="word-break:break-all; letter-spacing:@(_isRequest ? "0" : "0.1em")">@_qrText</code>
                    </div>
                    <button class="btn btn-primary" @onclick="CopyText">
                        <i class="bi @(_copied ? "bi-check-lg" : "bi-clipboard") me-1"></i>
                        @(_copied ? "Copied!" : _isRequest ? "Copy Payment Link" : "Copy Address")
                    </button>
                    @if (_qrSvg != null)
                    {
                        <button class="btn btn-outline-primary ms-2" @onclick="CopyQr">
                            <i class="bi @(_qrCopied ? "bi-check-lg" : "bi-image") me-1"></i>
                            @(_qrCopied ? "Copied!" : "Copy QR")
                        </button>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-5">
            <div class="card">
                <div class="card-header"><i class="bi bi-receipt me-1"></i>Payment request</div>
                <div class="card-body">
                    <p class="small text-muted">Optional: ask for a specific amount. Wallets that understand <code>qubic:</code> links pre-fill the payment.</p>
                    <div class="mb-2">
                        <label class="form-label small">Amount (QU)</label>
                        <input type="number" min="1" class="form-control form-control-sm" @bind="_reqAmount" @bind:after="Rebuild" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Message</label>
                        <input class="form-control form-control-sm" maxlength="120" placeholder="e.g. Invoice 42" @bind="_reqMessage" @bind:after="Rebuild" />
                    </div>
                    @if (!Backend.Profile.IsMainnet)
                    {
                        <div class="small text-muted mb-2"><i class="bi bi-cone-striped me-1"></i>The link is marked for <code>@Backend.Profile.ChainId</code> (you are on @Backend.Profile.Name).</div>
                    }
                    <button class="btn btn-sm btn-outline-secondary" @onclick="Clear" disabled="@(!_isRequest)">Show plain address</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _copied;
    private bool _qrCopied;
    private string? _qrSvg;
    private string _qrText = "";
    private bool _isRequest;
    private long? _reqAmount;
    private string? _reqMessage;

    protected override void OnParametersSet() => Rebuild();

    private void Rebuild()
    {
        if (Seed.Identity == null) return;
        var identity = Seed.Identity.Value.ToString();
        _isRequest = _reqAmount is > 0 || !string.IsNullOrWhiteSpace(_reqMessage) || !Backend.Profile.IsMainnet;
        _qrText = _isRequest
            ? new Qubic.Core.Payments.QubicPaymentRequest
            {
                Destination = identity,
                Amount = _reqAmount is > 0 ? _reqAmount : null,
                Message = string.IsNullOrWhiteSpace(_reqMessage) ? null : _reqMessage.Trim(),
                Network = Backend.Profile.IsMainnet ? null : "testnet",
            }.ToUri()
            : identity;

        var gen = new QRCoder.QRCodeGenerator();
        var data = gen.CreateQrCode(_qrText, QRCoder.QRCodeGenerator.ECCLevel.M);
        _qrSvg = new QRCoder.SvgQRCode(data).GetGraphic(5);
    }

    private void Clear()
    {
        _reqAmount = null;
        _reqMessage = null;
        Rebuild();
    }

    private async Task CopyText()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _qrText);
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }

    private async Task CopyQr()
    {
        if (_qrSvg == null) return;
        try
        {
            await JS.InvokeVoidAsync("copyQrAsImage", "qr-container");
            _qrCopied = true;
            StateHasChanged();
            await Task.Delay(2000);
            _qrCopied = false;
        }
        catch { }
    }
}
