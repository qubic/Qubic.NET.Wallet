@page "/receive"
@inject SeedSessionService Seed
@inject QubicBackendService Backend
@inject IJSRuntime JS
@inject Microsoft.Extensions.Localization.IStringLocalizer<AppStrings> Loc

<h4>@Loc["Receive_Title"]</h4>

@if (!Seed.HasSeed)
{
    <div class="alert alert-warning">@Loc["Receive_NeedSeed"]</div>
}
else
{
    <div class="row g-3">
        <div class="col-md-7">
            <div class="card">
                <div class="card-header">@Loc["Receive_YourIdentity"]</div>
                <div class="card-body text-center py-4">
                    <p class="text-muted small mb-3">
                        @(_isRequest ? Loc["Receive_ScanRequest"] : Loc["Receive_ShareAddress"])
                    </p>
                    @if (_qrSvg != null)
                    {
                        <div class="mb-3 d-flex justify-content-center">
                            <div id="qr-container" class="qb-qr-box">
                                @((MarkupString)_qrSvg)
                            </div>
                        </div>
                    }
                    <div class="p-3 bg-body-tertiary rounded mb-3">
                        <code class="mono d-block @(_isRequest ? "small" : "fs-5")" style="word-break:break-all; letter-spacing:@(_isRequest ? "0" : "0.1em")">@_qrText</code>
                    </div>
                    <button class="btn btn-primary" @onclick="CopyText">
                        <i class="bi @(_copied ? "bi-check-lg" : "bi-clipboard") me-1"></i>
                        @(_copied ? Loc["Common_Copied"] : _isRequest ? Loc["Receive_CopyLink"] : Loc["Receive_CopyAddress"])
                    </button>
                    @if (_qrSvg != null)
                    {
                        <button class="btn btn-outline-primary ms-2" @onclick="CopyQr">
                            <i class="bi @(_qrCopied ? "bi-check-lg" : "bi-image") me-1"></i>
                            @(_qrCopied ? Loc["Common_Copied"] : Loc["Receive_CopyQr"])
                        </button>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-5">
            <div class="card">
                <div class="card-header"><i class="bi bi-receipt me-1"></i>@Loc["Receive_PaymentRequest"]</div>
                <div class="card-body">
                    <p class="small text-muted">@Loc["Receive_PaymentHelp"] <code>qubic:</code> @Loc["Receive_PaymentHelpTail"]</p>
                    <div class="mb-2">
                        <label class="form-label small">@Loc["Send_Amount"]</label>
                        <input type="number" min="1" class="form-control form-control-sm" @bind="_reqAmount" @bind:after="Rebuild" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">@Loc["Common_Message"]</label>
                        <input class="form-control form-control-sm" maxlength="120" placeholder="@Loc["Receive_MessagePlaceholder"]" @bind="_reqMessage" @bind:after="Rebuild" />
                    </div>
                    @if (!Backend.Profile.IsMainnet)
                    {
                        <div class="small text-muted mb-2"><i class="bi bi-cone-striped me-1"></i>@Loc["Receive_LinkMarkedPre"] <code>@Backend.Profile.ChainId</code> @Loc["Receive_LinkMarkedYouAreOn"] @Backend.Profile.Name).</div>
                    }
                    <button class="btn btn-sm btn-outline-secondary" @onclick="Clear" disabled="@(!_isRequest)">@Loc["Receive_ShowPlain"]</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _copied;
    private bool _qrCopied;
    private string? _qrSvg;
    private string _qrText = "";
    private bool _isRequest;
    private long? _reqAmount;
    private string? _reqMessage;

    protected override void OnParametersSet() => Rebuild();

    private void Rebuild()
    {
        if (Seed.Identity == null) return;
        var identity = Seed.Identity.Value.ToString();
        _isRequest = _reqAmount is > 0 || !string.IsNullOrWhiteSpace(_reqMessage) || !Backend.Profile.IsMainnet;
        _qrText = _isRequest
            ? new Qubic.Core.Payments.QubicPaymentRequest
            {
                Destination = identity,
                Amount = _reqAmount is > 0 ? _reqAmount : null,
                Message = string.IsNullOrWhiteSpace(_reqMessage) ? null : _reqMessage.Trim(),
                Network = Backend.Profile.IsMainnet ? null : "testnet",
            }.ToUri()
            : identity;

        var gen = new QRCoder.QRCodeGenerator();
        var data = gen.CreateQrCode(_qrText, QRCoder.QRCodeGenerator.ECCLevel.M);
        _qrSvg = new QRCoder.SvgQRCode(data).GetGraphic(5, "#000000", "#ffffff", true, QRCoder.SvgQRCode.SizingMode.ViewBoxAttribute);
    }

    private void Clear()
    {
        _reqAmount = null;
        _reqMessage = null;
        Rebuild();
    }

    private async Task CopyText()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _qrText);
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }

    private async Task CopyQr()
    {
        if (_qrSvg == null) return;
        try
        {
            await JS.InvokeVoidAsync("copyQrAsImage", "qr-container");
            _qrCopied = true;
            StateHasChanged();
            await Task.Delay(2000);
            _qrCopied = false;
        }
        catch { }
    }
}
