@page "/"
@implements IDisposable
@inject SeedSessionService Seed
@inject QubicBackendService Backend
@inject TickMonitorService TickMonitor
@inject BalanceService BalanceSvc
@inject Qubic.Services.Storage.WalletStorageService WalletStorage
@inject TransactionTrackerService TxTracker
@inject IJSRuntime JS
@inject VaultService Vault
@inject QubicSettingsService Settings
@inject Qubic.Net.Wallet.Services.VaultActivationService VaultActivation
@inject Microsoft.Extensions.Localization.IStringLocalizer<AppStrings> Loc

<h4>@Loc["Home_Welcome"]</h4>

<VaultSwitchDialog @ref="_vaultDlg" OnChanged="OnVaultChangedFromDialog" />

@if (Vault.IsUnlocked && !Seed.HasSeed)
{
    <div class="row">
        <div class="col-12">
            <h5>@Loc["Home_SelectIdentity"]</h5>
            <p class="text-muted">
                @Loc["Home_SelectIdentityHint"]
                <a href="/accounts">@Loc["Nav_VaultOverview"]</a>.
            </p>
        </div>
        @foreach (var entry in Vault.Entries)
        {
            <div class="col-md-4 mb-3">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <i class="bi bi-person-circle display-4 text-primary mb-2 d-block"></i>
                        <h6>@entry.Label</h6>
                        <span class="mono small text-muted">@entry.Identity[..12]...</span>
                    </div>
                    <div class="card-footer text-center">
                        <button class="btn btn-primary btn-sm" @onclick="() => ActivateFromHome(entry)">
                            <i class="bi bi-unlock me-1"></i>@Loc["Home_Activate"]
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}
else if (!Seed.HasSeed)
{
    <div class="row">
        <div class="col-md-6">
            <div class="card mt-3">
                <div class="card-body text-center py-5">
                    <i class="bi bi-wallet2 display-1 text-primary mb-3 d-block"></i>
                    <h5>@Loc["Home_GetStarted"]</h5>
                    <p class="text-muted">@Loc["Home_GetStartedDesc"]</p>
                    <p class="small text-muted">@Loc["Home_SeedMemoryNote"]</p>
                    <button class="btn btn-outline-primary btn-sm" @onclick="() => _vaultDlg?.Open()">
                        <i class="bi bi-safe me-1"></i>@Loc["Home_OpenOrCreateVault"]
                    </button>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card mt-3">
                <div class="card-header">@Loc["Home_CreateNewWallet"]</div>
                <div class="card-body">
                    @if (_generatedSeed == null)
                    {
                        <p class="text-muted small">@Loc["Home_NoSeedYet"]</p>
                        <button class="btn btn-primary" @onclick="GenerateSeed">
                            <i class="bi bi-plus-circle me-1"></i>@Loc["Home_GenerateNewSeed"]
                        </button>
                    }
                    else
                    {
                        <div class="alert alert-danger py-2 mb-2">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            <strong>@Loc["Home_WriteDownSeed"]</strong>
                        </div>
                        <ul class="small text-muted mb-2">
                            <li>@Loc["Home_SeedBullet1"]</li>
                            <li>@Loc["Home_SeedBullet2"]</li>
                            <li>@Loc["Home_SeedBullet3"]</li>
                            <li>@Loc["Home_SeedBullet4"]</li>
                        </ul>
                        <div class="mb-2">
                            <label class="form-label-sm">@Loc["Home_YourNewSeed"]</label>
                            <div class="input-group">
                                <input type="@(_seedRevealed ? "text" : "password")" class="form-control form-control-sm mono"
                                       value="@_generatedSeed" readonly />
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => _seedRevealed = !_seedRevealed"
                                        title="@(_seedRevealed ? Loc["Common_Hide"] : Loc["Common_Reveal"])">
                                    <i class="bi @(_seedRevealed ? "bi-eye-slash" : "bi-eye")"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="CopyGeneratedSeed" title="@Loc["Common_CopyToClipboard"]">
                                    <i class="bi @(_seedCopied ? "bi-check-lg text-success" : "bi-clipboard")"></i>
                                </button>
                            </div>
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="seedSavedCheck"
                                   @bind="_seedSavedConfirmed" />
                            <label class="form-check-label small" for="seedSavedCheck">
                                @Loc["Home_SeedConfirmCheck"]
                            </label>
                        </div>
                        <div class="d-flex gap-2 flex-wrap">
                            <button class="btn btn-primary" @onclick="UseGeneratedSeed" disabled="@(!_seedSavedConfirmed)">
                                <i class="bi bi-unlock me-1"></i>@Loc["Home_UseThisSeed"]
                            </button>
                            <button class="btn btn-outline-primary" @onclick="() => _vaultDlg?.Open(_generatedSeed)" disabled="@(!_seedSavedConfirmed)">
                                <i class="bi bi-safe me-1"></i>@Loc["Home_SaveAsVault"]
                            </button>
                            <button class="btn btn-outline-secondary" @onclick="GenerateSeed">
                                <i class="bi bi-arrow-clockwise me-1"></i>@Loc["Home_GenerateAnother"]
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
else
{
    @if (!Vault.VaultConfigured)
    {
        <div class="alert alert-info small py-2 mb-3">
            <i class="bi bi-lightbulb me-1"></i>
            <strong>@Loc["Common_Tip"]</strong> @Loc["Home_TipSaveVault"]
        </div>
    }

    @* ── Identity + Balance + Network ── *@
    <div class="card mb-3">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-5 mb-2 mb-md-0">
                    <div class="small text-muted mb-1">@Loc["Common_Identity"]</div>
                    <AddressDisplay Address="@Seed.Identity?.ToString()" ShowFull="true" />
                </div>
                <div class="col-md-4 mb-2 mb-md-0">
                    <div class="small text-muted mb-1">@Loc["Common_Balance"]</div>
                    @if (BalanceSvc.IsLoading && BalanceSvc.Balance == null)
                    {
                        <span class="text-muted"><span class="spinner-border spinner-border-sm me-1"></span> @Loc["Common_Loading"]</span>
                    }
                    else if (BalanceSvc.Balance != null)
                    {
                        <h3 class="mb-0">@BalanceSvc.Balance.Value.ToString("N0") <small class="text-muted">QU</small></h3>
                    }
                    else if (BalanceSvc.Error != null)
                    {
                        <span class="text-danger small">@BalanceSvc.Error</span>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-outline-primary" @onclick="BalanceSvc.RequestRefresh">@Loc["Home_LoadBalance"]</button>
                    }
                </div>
                <div class="col-md-3 text-md-end">
                    @if (TickMonitor.IsConnected)
                    {
                        <div class="small text-muted">@Loc["Common_Epoch"] <strong class="text-body">@TickMonitor.Epoch</strong></div>
                        <div class="small text-muted">@Loc["Common_Tick"] <strong class="text-body">@TickMonitor.Tick.ToString("N0")</strong></div>
                    }
                    else
                    {
                        <span class="text-muted small">@Loc["Common_NotConnected"]</span>
                    }
                </div>
            </div>
        </div>
    </div>

    @* ── Wallet status ── *@
    <div class="row g-3 mb-3">
        @* Network & connection health *@
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body py-3">
                    <div class="d-flex justify-content-between align-items-start mb-1">
                        <span class="small text-muted">@Loc["Home_Network"]</span>
                        @if (TickMonitor.IsConnected)
                        {
                            <span class="badge bg-success"><i class="bi bi-circle-fill me-1" style="font-size:.5em"></i>@Loc["Home_Connected"]</span>
                        }
                        else
                        {
                            <span class="badge bg-danger"><i class="bi bi-circle-fill me-1" style="font-size:.5em"></i>@Loc["Home_Offline"]</span>
                        }
                    </div>
                    <div class="fw-semibold"><i class="bi bi-hdd-network me-1"></i>@Backend.Profile.Name</div>
                    @if (TickMonitor.IsConnected)
                    {
                        <div class="small text-muted mt-1">@Loc["Common_Epoch"] <strong class="text-body">@TickMonitor.Epoch</strong> · @Loc["Common_Tick"] <strong class="text-body">@TickMonitor.Tick.ToString("N0")</strong></div>
                    }
                    else if (TickMonitor.Error != null)
                    {
                        <div class="small text-danger mt-1 text-truncate" title="@TickMonitor.Error">@TickMonitor.Error</div>
                    }
                </div>
            </div>
        </div>

        @* Vault summary *@
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body py-3">
                    <div class="d-flex justify-content-between align-items-start mb-1">
                        <span class="small text-muted">@Loc["Home_VaultCard"]</span>
                        <span class="d-flex gap-2">
                            <button class="btn btn-link btn-sm p-0 small" @onclick="() => _vaultDlg?.Open()">@Loc["VSw_Switch"]</button>
                            <a class="small" href="/accounts">@Loc["Common_ViewAll"]</a>
                        </span>
                    </div>
                    @if (Vault.IsUnlocked)
                    {
                        <div class="fw-semibold text-truncate" title="@Vault.VaultPath">
                            <i class="bi bi-safe me-1"></i>@VaultFileHistory.DisplayName(Vault.VaultPath ?? "")
                        </div>
                        <div class="small text-muted">@Vault.Entries.Count @Loc["VO_Identities"]</div>
                        <div class="small text-muted">@Loc["Home_VaultTotal"]:
                            @if (_vaultTotal != null)
                            {
                                <strong class="text-body">@_vaultTotal.Value.ToString("N0") QU</strong>
                                @if (_vaultTotalPartial) { <span class="text-muted"> …</span> }
                            }
                            else
                            {
                                <span class="spinner-border spinner-border-sm text-muted"></span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="small text-muted"><i class="bi bi-lock me-1"></i>@Loc["VO_Locked"]</div>
                    }
                </div>
            </div>
        </div>

        @* Pending transactions *@
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body py-3">
                    @{ var pending = TxTracker.Transactions.Where(t => t.Status == Qubic.Services.TrackedTxStatus.Pending).OrderBy(t => t.TargetTick).ToList(); }
                    <div class="d-flex justify-content-between align-items-start mb-1">
                        <span class="small text-muted">@Loc["Home_PendingTitle"]</span>
                        @if (pending.Count > 0)
                        {
                            <span class="badge bg-warning text-dark">@pending.Count</span>
                        }
                    </div>
                    @if (pending.Count == 0)
                    {
                        <div class="small text-muted"><i class="bi bi-check2-circle me-1"></i>@Loc["Home_NoPending"]</div>
                    }
                    else
                    {
                        <ul class="list-unstyled mb-0 small">
                            @foreach (var t in pending.Take(3))
                            {
                                <li class="d-flex justify-content-between gap-2">
                                    <span class="d-flex align-items-center gap-1 text-truncate">
                                        <span class="spinner-border spinner-border-sm text-warning" style="width:.7em;height:.7em"></span>
                                        <span class="mono">@t.Amount.ToString("N0") QU</span>
                                    </span>
                                    <span class="text-muted text-nowrap">@Loc["Home_AtTick"] @t.TargetTick.ToString("N0")</span>
                                </li>
                            }
                        </ul>
                        @if (pending.Count > 3)
                        {
                            <a class="small" href="/history">+@(pending.Count - 3) · @Loc["Common_ViewAll"]</a>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    @* ── Quick Actions ── *@
    <div class="d-flex flex-wrap gap-2 mb-3">
        <a class="btn btn-primary quick-action-btn" href="/send"><i class="bi bi-send me-1"></i>@Loc["Nav_Send"]</a>
        <a class="btn btn-outline-primary quick-action-btn" href="/receive"><i class="bi bi-qr-code me-1"></i>@Loc["Nav_Receive"]</a>
        <a class="btn btn-outline-primary quick-action-btn" href="/assets"><i class="bi bi-grid-3x3-gap me-1"></i>@Loc["Nav_Assets"]</a>
        <a class="btn btn-outline-primary quick-action-btn" href="/qx"><i class="bi bi-shop me-1"></i>@Loc["Nav_QxTrading"]</a>
        <a class="btn btn-outline-primary quick-action-btn" href="/history"><i class="bi bi-list-ul me-1"></i>@Loc["Common_History"]</a>
    </div>

    @* ── Sync Status ── *@
    @if (WalletStorage.IsOpen)
    {
        <div class="card mb-3">
            <div class="card-body py-2">
                @{ var sync = WalletStorage.Sync; }
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    @if (sync.State == Qubic.Services.Storage.SyncState.Syncing)
                    {
                        <span class="d-flex align-items-center gap-1">
                            <span class="spinner-border spinner-border-sm text-primary"></span>
                            <span class="small">@Loc["Common_Syncing"]</span>
                        </span>
                    }
                    else
                    {
                        <span class="small text-muted"><strong class="text-body">@WalletStorage.TransactionCount</strong> @Loc["Home_TransactionsWord"], <strong class="text-body">@WalletStorage.LogEventCount</strong> @Loc["Home_LogEventsWord"]</span>
                    }
                    <span class="small">@StreamIcon(sync.RpcStatus) RPC: <span class="text-muted">@(sync.RpcStatusMessage ?? Loc["Common_Idle"])</span></span>
                    <span class="small">@StreamIcon(sync.BobLogStatus) Logs: <span class="text-muted">@(sync.BobLogStatusMessage ?? Loc["Common_Idle"])</span></span>
                    @if (sync.LastError != null)
                    {
                        <span class="text-danger small"><i class="bi bi-exclamation-triangle me-1"></i>@sync.LastError</span>
                    }
                </div>
            </div>
        </div>
    }

    @* ── Assets & Orders ── *@
    <div class="row">
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>@Loc["Home_OwnedAssets"]</span>
                    <a class="btn btn-sm btn-outline-primary" href="/assets">@Loc["Common_ViewAll"]</a>
                </div>
                <div class="card-body">
                    @if (_assetsLoading)
                    {
                        <span class="text-muted"><span class="spinner-border spinner-border-sm me-1"></span> @Loc["Home_LoadingAssets"]</span>
                    }
                    else if (_ownedAssets != null && _ownedAssets.Any(a => a.Data.NumberOfUnits != "0"))
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover mb-0">
                                <thead>
                                    <tr><th>@Loc["Common_Asset"]</th><th>@Loc["Common_Shares"]</th><th>@Loc["Common_Contract"]</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var a in _ownedAssets.Where(a => a.Data.NumberOfUnits != "0"))
                                    {
                                        <tr>
                                            <td class="mono">@(a.Data.IssuedAsset?.Name ?? "?")</td>
                                            <td class="mono">@a.Data.NumberOfUnits</td>
                                            <td>@Qubic.Core.QubicContracts.FormatContract((int)a.Data.ManagingContractIndex)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else if (_assetsError != null)
                    {
                        <span class="text-danger small">@_assetsError</span>
                    }
                    else
                    {
                        <span class="text-muted">@Loc["Home_NoOwnedAssets"]</span>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>@Loc["Home_OpenQxOrders"]</span>
                    <a class="btn btn-sm btn-outline-primary" href="/qx">View All</a>
                </div>
                <div class="card-body">
                    @if (_ordersLoading)
                    {
                        <span class="text-muted"><span class="spinner-border spinner-border-sm me-1"></span> @Loc["Home_LoadingOrders"]</span>
                    }
                    else if ((_askOrders != null && _askOrders.Count > 0) || (_bidOrders != null && _bidOrders.Count > 0))
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover mb-0">
                                <thead>
                                    <tr><th>@Loc["Common_Type"]</th><th>@Loc["Common_Asset"]</th><th>@Loc["Common_Price"]</th><th>@Loc["Common_Shares"]</th></tr>
                                </thead>
                                <tbody>
                                    @if (_askOrders != null)
                                    {
                                        @foreach (var o in _askOrders)
                                        {
                                            <tr>
                                                <td><span class="badge-qb-danger">@Loc["Common_Ask"]</span></td>
                                                <td class="mono">@(Qubic.Core.AssetNameHelper.FromUlong(o.AssetName) ?? "?")</td>
                                                <td class="mono">@o.Price.ToString("N0")</td>
                                                <td class="mono">@o.NumberOfShares.ToString("N0")</td>
                                            </tr>
                                        }
                                    }
                                    @if (_bidOrders != null)
                                    {
                                        @foreach (var o in _bidOrders)
                                        {
                                            <tr>
                                                <td><span class="badge-qb-success">@Loc["Common_Bid"]</span></td>
                                                <td class="mono">@(Qubic.Core.AssetNameHelper.FromUlong(o.AssetName) ?? "?")</td>
                                                <td class="mono">@o.Price.ToString("N0")</td>
                                                <td class="mono">@o.NumberOfShares.ToString("N0")</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else if (_ordersError != null)
                    {
                        <span class="text-danger small">@_ordersError</span>
                    }
                    else
                    {
                        <span class="text-muted">@Loc["Home_NoOpenOrders"]</span>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _disposed;

    // Seed generation
    private string? _generatedSeed;
    private bool _seedRevealed;
    private bool _seedCopied;
    private bool _seedSavedConfirmed;

    // Owned assets
    private IReadOnlyList<Qubic.Rpc.Models.OwnedAssetInfo>? _ownedAssets;
    private bool _assetsLoading;
    private string? _assetsError;

    // QX orders
    private List<Qubic.Core.Contracts.Qx.EntityAskOrdersOrder>? _askOrders;
    private List<Qubic.Core.Contracts.Qx.EntityBidOrdersOrder>? _bidOrders;
    private bool _ordersLoading;
    private string? _ordersError;

    // Vault total (sum across all identities)
    private long? _vaultTotal;
    private bool _vaultTotalPartial;

    private VaultSwitchDialog? _vaultDlg;

    private async Task OnVaultChangedFromDialog()
    {
        _vaultTotal = null;
        if (Seed.HasSeed) BalanceSvc.RequestRefresh();
        await LoadVaultTotal();
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        TickMonitor.OnTickChanged += OnTickChanged;
        Seed.OnSeedChanged += OnSeedChanged;
        WalletStorage.Sync.OnSyncStateChanged += OnSyncChanged;
        BalanceSvc.OnBalanceChanged += OnBalanceChanged;
        TxTracker.OnChanged += OnTxChanged;

        if (Seed.HasSeed)
        {
            BalanceSvc.RequestRefresh();
            var assetsTask = LoadAssets();
            var ordersTask = LoadOrders();
            var totalTask = LoadVaultTotal();
            await Task.WhenAll(assetsTask, ordersTask, totalTask);
        }
    }

    private void OnTxChanged()
    {
        if (_disposed) return;
        InvokeAsync(() => { if (!_disposed) StateHasChanged(); });
    }

    private async Task LoadVaultTotal()
    {
        if (!Vault.IsUnlocked || Vault.Entries.Count == 0) { _vaultTotal = null; return; }
        var identities = Vault.Entries.Select(e => e.Identity).ToList();
        long sum = 0;
        var partial = false;
        using var gate = new SemaphoreSlim(4);
        await Task.WhenAll(identities.Select(async id =>
        {
            await gate.WaitAsync();
            try
            {
                var bal = await Backend.GetBalanceAsync(Qubic.Core.Entities.QubicIdentity.FromIdentity(id));
                System.Threading.Interlocked.Add(ref sum, bal.Amount);
            }
            catch { partial = true; }
            finally { gate.Release(); }
        }));
        _vaultTotal = sum;
        _vaultTotalPartial = partial;
        if (!_disposed) await InvokeAsync(StateHasChanged);
    }

    private void OnTickChanged()
    {
        if (_disposed) return;
        InvokeAsync(() => { if (!_disposed) StateHasChanged(); });
    }

    private void OnSyncChanged()
    {
        if (_disposed) return;
        InvokeAsync(() => { if (!_disposed) StateHasChanged(); });
    }

    private void OnSeedChanged()
    {
        if (_disposed) return;
        InvokeAsync(async () =>
        {
            if (_disposed) return;
            _ownedAssets = null;
            _assetsError = null;
            _askOrders = null;
            _bidOrders = null;
            _ordersError = null;
            _vaultTotal = null;
            if (Seed.HasSeed)
            {
                var t1 = LoadAssets();
                var t2 = LoadOrders();
                var t3 = LoadVaultTotal();
                await Task.WhenAll(t1, t2, t3);
            }
            StateHasChanged();
        });
    }

    private void OnBalanceChanged()
    {
        if (_disposed) return;
        InvokeAsync(() => { if (!_disposed) StateHasChanged(); });
    }

    private async Task LoadAssets()
    {
        if (!Seed.HasSeed || Seed.Identity == null) return;
        _assetsLoading = true;
        _assetsError = null;
        try
        {
            _ownedAssets = await Backend.GetOwnedAssetsAsync(Seed.Identity.Value);
        }
        catch (Exception ex)
        {
            _assetsError = ex.Message;
        }
        finally
        {
            _assetsLoading = false;
        }
    }

    private async Task LoadOrders()
    {
        if (!Seed.HasSeed || Seed.Identity == null) return;
        _ordersLoading = true;
        _ordersError = null;
        try
        {
            var pk = Seed.Identity.Value.PublicKey;

            var askInput = new Qubic.Core.Contracts.Qx.EntityAskOrdersInput { Entity = pk, Offset = 0 }.ToBytes();
            var bidInput = new Qubic.Core.Contracts.Qx.EntityBidOrdersInput { Entity = pk, Offset = 0 }.ToBytes();

            var askTask = Backend.QuerySmartContractAsync(1, 4, askInput);
            var bidTask = Backend.QuerySmartContractAsync(1, 5, bidInput);
            await Task.WhenAll(askTask, bidTask);

            var askResult = askTask.Result;
            if (askResult.Length >= Qubic.Core.Contracts.Qx.EntityAskOrdersOrder.Size)
            {
                var output = Qubic.Core.Contracts.Qx.EntityAskOrdersOutput.FromBytes(askResult);
                _askOrders = output.Orders.Where(o => o.NumberOfShares > 0).ToList();
            }

            var bidResult = bidTask.Result;
            if (bidResult.Length >= Qubic.Core.Contracts.Qx.EntityBidOrdersOrder.Size)
            {
                var output = Qubic.Core.Contracts.Qx.EntityBidOrdersOutput.FromBytes(bidResult);
                _bidOrders = output.Orders.Where(o => o.NumberOfShares > 0).ToList();
            }
        }
        catch (Exception ex)
        {
            _ordersError = ex.Message;
        }
        finally
        {
            _ordersLoading = false;
        }
    }

    private static MarkupString StreamIcon(Qubic.Services.Storage.StreamStatus status) => status switch
    {
        Qubic.Services.Storage.StreamStatus.Connecting or Qubic.Services.Storage.StreamStatus.CatchingUp =>
            new MarkupString("<span class=\"spinner-border spinner-border-sm text-primary\" style=\"width:.7em;height:.7em\"></span>"),
        Qubic.Services.Storage.StreamStatus.Live =>
            new MarkupString("<i class=\"bi bi-check-circle-fill text-success\"></i>"),
        Qubic.Services.Storage.StreamStatus.Error =>
            new MarkupString("<i class=\"bi bi-exclamation-triangle-fill text-danger\"></i>"),
        _ => new MarkupString("<i class=\"bi bi-circle text-muted\"></i>"),
    };

    private void GenerateSeed()
    {
        _generatedSeed = Qubic.Core.QubicSeed.Generate();
        _seedRevealed = false;
        _seedCopied = false;
        _seedSavedConfirmed = false;
    }

    private async Task CopyGeneratedSeed()
    {
        if (_generatedSeed == null) return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _generatedSeed);
        _seedCopied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _seedCopied = false;
    }

    private void ActivateFromHome(VaultEntry entry)
    {
        try { VaultActivation.Activate(entry); }
        catch { }
    }

    private void UseGeneratedSeed()
    {
        if (_generatedSeed == null || !_seedSavedConfirmed) return;
        try
        {
            Seed.SetSeed(_generatedSeed);
            WalletStorage.SetSeed(_generatedSeed, Seed.Identity!.Value.ToString(), TickMonitor.Epoch, skipInitialSync: true);
            TxTracker.SetEncryptionKey(_generatedSeed);
            _generatedSeed = null;
            _seedSavedConfirmed = false;
        }
        catch { }
    }

    public void Dispose()
    {
        _disposed = true;
        TickMonitor.OnTickChanged -= OnTickChanged;
        Seed.OnSeedChanged -= OnSeedChanged;
        WalletStorage.Sync.OnSyncStateChanged -= OnSyncChanged;
        BalanceSvc.OnBalanceChanged -= OnBalanceChanged;
        TxTracker.OnChanged -= OnTxChanged;
    }
}
